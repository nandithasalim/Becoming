# Copy to .env and fill in.

# Local dev: leave as SQLite. Production (Supabase): Project Settings -> Database -> Connection string (URI),
# then change the start to postgresql+psycopg://
DATABASE_URL=sqlite:///./future_self.db

# Long random string. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=

# true only on your laptop: lets you sign in with just an email
DEV_LOGIN=true

CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
